+ CURRENT_LLVM_STABLE=22
+ BASE_URL=https://apt.llvm.org
+ NEW_DEBIAN_DISTROS=("trixie" "forky" "unstable")
+ LLVM_VERSION=22
+ ALL=0
++ lsb_release -is
+ DISTRO=Ubuntu
++ lsb_release -cs
+ VERSION_CODENAME=noble
++ lsb_release -sr
+ VERSION=24.04
+ UBUNTU_CODENAME=
+ CODENAME_FROM_ARGUMENTS=
+ source /etc/os-release
++ PRETTY_NAME='Ubuntu 24.04.4 LTS'
++ NAME=Ubuntu
++ VERSION_ID=24.04
++ VERSION='24.04.4 LTS (Noble Numbat)'
++ VERSION_CODENAME=noble
++ ID=ubuntu
++ ID_LIKE=debian
++ HOME_URL=https://www.ubuntu.com/
++ SUPPORT_URL=https://help.ubuntu.com/
++ BUG_REPORT_URL=https://bugs.launchpad.net/ubuntu/
++ PRIVACY_POLICY_URL=https://www.ubuntu.com/legal/terms-and-policies/privacy-policy
++ UBUNTU_CODENAME=noble
++ LOGO=ubuntu-logo
+ DISTRO=ubuntu
+ is_new_debian=0
+ [[ ubuntu == \d\e\b\i\a\n ]]
+ needed_binaries=(lsb_release wget gpg)
+ [[ 0 -eq 0 ]]
+ needed_binaries+=(add-apt-repository)
+ missing_binaries=()
+ for binary in "${needed_binaries[@]}"
+ command -v lsb_release
+ for binary in "${needed_binaries[@]}"
+ command -v wget
+ for binary in "${needed_binaries[@]}"
+ command -v gpg
+ for binary in "${needed_binaries[@]}"
+ command -v add-apt-repository
+ [[ 0 -gt 0 ]]
+ case ${DISTRO} in
+ [[ -n noble ]]
+ CODENAME=noble
+ [[ -n noble ]]
+ LINKNAME=-noble
+ for arg in "$@"
+ case "${arg}" in
+ '[' 1 -ge 1 ']'
+ '[' 2 '!=' - ']'
+ '[' 21 '!=' all ']'
+ LLVM_VERSION=21
+ OPTIND=2
+ '[' 1 -ge 2 ']'
+ getopts :hm:n: arg
+ [[ 0 -ne 0 ]]
+ declare -A LLVM_VERSION_PATTERNS
+ LLVM_VERSION_PATTERNS[9]=-9
+ LLVM_VERSION_PATTERNS[10]=-10
+ LLVM_VERSION_PATTERNS[11]=-11
+ LLVM_VERSION_PATTERNS[12]=-12
+ LLVM_VERSION_PATTERNS[13]=-13
+ LLVM_VERSION_PATTERNS[14]=-14
+ LLVM_VERSION_PATTERNS[15]=-15
+ LLVM_VERSION_PATTERNS[16]=-16
+ LLVM_VERSION_PATTERNS[17]=-17
+ LLVM_VERSION_PATTERNS[18]=-18
+ LLVM_VERSION_PATTERNS[19]=-19
+ LLVM_VERSION_PATTERNS[20]=-20
+ LLVM_VERSION_PATTERNS[21]=-21
+ LLVM_VERSION_PATTERNS[22]=-22
+ LLVM_VERSION_PATTERNS[23]=-23
+ LLVM_VERSION_PATTERNS[24]=
+ '[' '!' _ ']'
+ LLVM_VERSION_STRING=-21
+ [[ -n noble ]]
+ REPO_NAME='deb https://apt.llvm.org/noble/  llvm-toolchain-noble-21 main'
+ check_url https://apt.llvm.org/noble/
+ local url=https://apt.llvm.org/noble/
+ command -v wget
+ wget -q --method=HEAD --timeout=15 --tries=3 https://apt.llvm.org/noble/
+ [[ ! -f /etc/apt/trusted.gpg.d/apt.llvm.org.asc ]]
+ GPG_KEY_URL=https://apt.llvm.org/llvm-snapshot.gpg.key
+ check_url https://apt.llvm.org/llvm-snapshot.gpg.key
+ local url=https://apt.llvm.org/llvm-snapshot.gpg.key
+ command -v wget
+ wget -q --method=HEAD --timeout=15 --tries=3 https://apt.llvm.org/llvm-snapshot.gpg.key
+ download_key https://apt.llvm.org/llvm-snapshot.gpg.key
+ local url=https://apt.llvm.org/llvm-snapshot.gpg.key
+ command -v wget
+ wget -qO- --retry-connrefused --waitretry=1 --tries=3 https://apt.llvm.org/llvm-snapshot.gpg.key
+ tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc
